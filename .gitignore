# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.egg-info/
*.egg
dist/
dist-*/
build/
wheels/
*.whl
*.tar.gz

# CI fixtures (negative-test mutation of the signed fixture; CI workflow
# writes this at workspace root and never cleans it up)
attestation.tampered.json

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
_load_env.ps1

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Internal launch / marketing artifacts (not for public repo)
.launch/

# Nested vendor checkout (its own git repo)
superpowers/

# topofuzz local artifacts
runs/
.cache/
*.pem
!keys/*.pub.pem
# Published gallery runs (BLUEPRINT 19a) are committed deliberately
!examples/gallery/*/runs/
!examples/gallery/*/runs/**

# topofuzz UI server runtime artifacts (local-only, ephemeral)
ui_server.log
ui_server.err.log
.playwright-mcp/
ui-*.png

# uv lock state lives at workspace root only; per-package locks not used
packages/*/uv.lock

