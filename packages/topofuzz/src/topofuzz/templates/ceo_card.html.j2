<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'none'; base-uri 'none'; form-action 'none';">
<meta name="referrer" content="no-referrer">
<title>topofuzz CEO card — {{ topology_name }}</title>
<style>
  @page {
    size: Letter;
    margin: 0.55in 0.6in 0.55in 0.6in;
  }
  :root {
    --bg: #faf7f2;
    --surface: #ffffff;
    --border: #e7d8c2;
    --border-soft: #f0eae0;
    --ink: #2a2622;
    --ink-strong: #1f1c19;
    --muted: #897764;
    --muted-soft: #6b5f54;
    --accent: #c25024;
    --accent-soft: #d97757;
    --flip-bg: #fce8e3;
    --flip-border: #ecbf9a;
    --flip-ink: #7a1f1f;
    --stable-bg: #ecf3ed;
    --stable-border: #cfe1d3;
    --stable-ink: #2f5a3d;
    --font-serif: "Source Serif Pro", "Source Serif 4", Georgia, "Times New Roman", serif;
    --font-sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.45;
    font-size: 11pt;
    -webkit-font-smoothing: antialiased;
  }
  .container {
    max-width: 7.4in;
    margin: 0 auto;
    padding: 0;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 6px 0;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 22pt;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    margin: 0 0 10px 0;
  }
  .lede {
    font-family: var(--font-serif);
    font-size: 13pt;
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 18px 0;
  }
  .headline-stat {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    background: #fff;
    margin: 0 0 16px 0;
  }
  .headline-stat .pct {
    font-family: var(--font-serif);
    font-size: 38pt;
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }
  .headline-stat .body {
    flex: 1;
  }
  .headline-stat .body .label {
    font-family: var(--font-sans);
    font-size: 10pt;
    color: var(--ink-strong);
    font-weight: 600;
    margin-bottom: 2px;
  }
  .headline-stat .body .ci {
    font-family: var(--font-mono);
    font-size: 9pt;
    color: var(--muted-soft);
  }
  .what {
    margin: 0 0 16px 0;
    padding: 12px 14px;
    background: var(--surface);
    border-left: 3px solid var(--accent-soft);
    font-size: 10.5pt;
    line-height: 1.5;
  }
  .what strong {
    color: var(--ink-strong);
  }
  h2 {
    font-family: var(--font-serif);
    font-size: 13pt;
    font-weight: 500;
    color: var(--ink-strong);
    margin: 18px 0 8px 0;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--border);
  }
  .flip-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 0 16px 0;
  }
  .flip-cell {
    padding: 10px 12px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 9.5pt;
    line-height: 1.4;
  }
  .flip-cell.approve {
    background: var(--stable-bg);
    border-color: var(--stable-border);
  }
  .flip-cell.deny {
    background: var(--flip-bg);
    border-color: var(--flip-border);
  }
  .flip-cell .badge {
    font-family: var(--font-mono);
    font-size: 8.5pt;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .flip-cell.approve .badge { color: var(--stable-ink); }
  .flip-cell.deny .badge { color: var(--flip-ink); }
  .flip-cell .ordering {
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--muted-soft);
    margin-bottom: 6px;
  }
  .flip-cell .verdict-text {
    font-family: var(--font-serif);
    color: var(--ink-strong);
  }
  .eval-prompt {
    font-family: var(--font-serif);
    font-size: 10pt;
    font-style: italic;
    color: var(--muted-soft);
    margin: 0 0 10px 0;
    padding-left: 12px;
    border-left: 2px solid var(--border);
  }
  .footer {
    margin-top: 22px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 7.5pt;
    color: var(--muted-soft);
    line-height: 1.5;
  }
  .footer .attest {
    word-break: break-all;
  }
  .footer .cta {
    font-family: var(--font-sans);
    font-size: 9.5pt;
    color: var(--ink-strong);
    margin: 0 0 6px 0;
    font-weight: 500;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 8.5pt;
    color: var(--muted-soft);
    margin: 0 0 14px 0;
  }
  .meta-row strong {
    color: var(--ink-strong);
    font-weight: 600;
  }
  .stable-callout {
    padding: 12px 14px;
    border: 1.5px solid var(--stable-border);
    background: var(--stable-bg);
    border-radius: 6px;
    color: var(--stable-ink);
    margin: 0 0 16px 0;
    font-size: 10.5pt;
  }
</style>
</head>
<body>
<div class="container">
  <div class="eyebrow">topofuzz · multi-agent topology fragility audit</div>
  <h1>{{ headline_title }}</h1>
  <p class="lede">{{ headline_lede }}</p>

  {% if flip_pct_str %}
  <div class="headline-stat">
    <div class="pct">{{ flip_pct_str }}</div>
    <div class="body">
      <div class="label">{{ flip_label }}</div>
      <div class="ci">{{ ci_str }}</div>
    </div>
  </div>
  {% else %}
  <div class="stable-callout">
    <strong>This run is stable.</strong> No verdicts flipped across
    {{ n_pairs_str }} variant pairings tested. That itself is a
    publishable claim &mdash; few multi-agent pipelines survive that
    test.
  </div>
  {% endif %}

  <div class="what">{{ what_paragraph }}</div>

  <div class="meta-row">
    <span><strong>Topology:</strong> {{ topology_name }}</span>
    <span><strong>Variants tested:</strong> {{ n_variants }}</span>
    <span><strong>Evals:</strong> {{ n_evals }}</span>
    <span><strong>Cost:</strong> {{ cost_str }}</span>
  </div>

  {% if flip_card %}
  <h2>One verdict that flipped</h2>
  <div class="eval-prompt">{{ flip_card.eval_prompt_excerpt }}</div>
  <div class="flip-card">
    <div class="flip-cell {{ flip_card.canonical_class }}">
      <div class="badge">Canonical ordering &middot; {{ flip_card.canonical_verdict }}</div>
      <div class="ordering">{{ flip_card.canonical_ordering }}</div>
      <div class="verdict-text">{{ flip_card.canonical_excerpt }}</div>
    </div>
    <div class="flip-cell {{ flip_card.variant_class }}">
      <div class="badge">Re-ordered &middot; {{ flip_card.variant_verdict }}</div>
      <div class="ordering">{{ flip_card.variant_ordering }}</div>
      <div class="verdict-text">{{ flip_card.variant_excerpt }}</div>
    </div>
  </div>
  {% endif %}

  <div class="footer">
    <div class="cta">{{ cta_line }}</div>
    <div>topofuzz · run {{ run_id }} · TDS v{{ tds_version }} · signed {{ signed_at }}</div>
    <div class="attest">verify: copy <code>{{ run_id }}</code> into <code>topofuzz verify</code> against the source bundle.</div>
  </div>
</div>
</body>
</html>
