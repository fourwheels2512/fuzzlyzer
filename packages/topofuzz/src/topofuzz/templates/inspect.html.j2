<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'none'; base-uri 'none'; form-action 'none';">
<meta name="referrer" content="no-referrer">
<title>topofuzz™ inspect &mdash; {{ run_id }} / {{ eval_id }}</title>
<style>
  :root {
    --bg: #faf7f2;
    --surface: #ffffff;
    --surface-warm: #fbf6ee;
    --border: #e7d8c2;
    --border-soft: #f0eae0;
    --ink: #2a2622;
    --ink-strong: #1f1c19;
    --muted: #897764;
    --muted-soft: #6b5f54;
    --accent: #c25024;
    --accent-soft: #d97757;
    --approve: #5a8b6b;
    --approve-bg: #ecf3ed;
    --approve-border: #cfe1d3;
    --deny: #9a1c0f;
    --deny-bg: #fce8e3;
    --deny-border: #ecbf9a;
    --concern: #8c4318;
    --concern-bg: #fce8d8;
    --concern-border: #ecbf9a;
    --font-serif: "Source Serif Pro", "Source Serif 4", Georgia, "Times New Roman", serif;
    --font-sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 40px 28px 80px;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    margin: 0 0 8px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }
  .subhead {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--muted-soft);
    font-style: italic;
    margin: 0 0 28px;
    line-height: 1.55;
    max-width: 720px;
  }

  /* Run-metadata strip — small monospace tags. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    padding: 14px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 32px;
    font-size: 13px;
    color: var(--muted-soft);
  }
  .meta .pair { display: inline-flex; gap: 6px; align-items: baseline; }
  .meta .k {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }
  .meta .v {
    font-family: var(--font-mono);
    color: var(--ink-strong);
    font-size: 12.5px;
    background: var(--border-soft);
    padding: 1px 7px;
    border-radius: 4px;
  }

  /* Two-column comparison grid. */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .panel.flipping { border-color: var(--accent-soft); }
  .panel header {
    padding: 22px 24px 18px;
    background: var(--surface-warm);
    border-bottom: 1px solid var(--border-soft);
  }
  .panel.flipping header { background: #fbf1ec; }
  .panel-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .panel.flipping .panel-eyebrow { color: var(--accent); }
  .panel h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--ink-strong);
    margin: 0 0 4px;
    letter-spacing: -0.005em;
  }
  .panel-hash {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .panel-hash code {
    background: var(--border-soft);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--ink-strong);
  }
  .verdict {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    border: 1px solid;
  }
  .verdict-approve { background: var(--approve-bg); color: var(--approve); border-color: var(--approve-border); }
  .verdict-deny    { background: var(--deny-bg);    color: var(--deny);    border-color: var(--deny-border); }
  .verdict-unknown { background: var(--border-soft); color: var(--muted);  border-color: var(--border); }

  .ordering {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-soft);
    line-height: 1.7;
    word-break: break-word;
  }
  .ordering .step {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    color: var(--ink-strong);
  }
  .ordering .arrow { color: var(--accent); margin: 0 4px; }

  .panel-body {
    padding: 18px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .rationale {
    background: var(--surface-warm);
    border: 1px solid var(--border-soft);
    border-left: 3px solid var(--accent-soft);
    border-radius: 8px;
    padding: 12px 16px;
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--ink);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .rationale-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  /* Per-judge vote panel — only shown when --jury-of-3 fired. */
  .jury {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    overflow: hidden;
  }
  .jury-head {
    padding: 10px 16px;
    background: var(--surface-warm);
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .jury-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .jury-summary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
    color: var(--muted-soft);
  }
  .jury-summary strong { color: var(--ink-strong); font-style: normal; font-weight: 600; }
  .jury-rows {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-soft);
  }
  .jury-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 70px 90px;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    background: var(--surface);
  }
  .jury-row + .jury-row { /* SVG-less divider between rows */ }
  .jury-vendor {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-strong);
    word-break: break-all;
  }
  .jury-score {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-soft);
    text-align: right;
  }
  .jury-verdict {
    text-align: right;
  }
  .jury-verdict .verdict {
    /* Smaller pill on the per-vendor row vs the headline pill. */
    padding: 2px 9px;
    font-size: 10px;
  }
  .jury-rationale {
    grid-column: 1 / -1;
    padding: 6px 0 0 0;
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--muted-soft);
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .error-banner {
    background: var(--deny-bg);
    color: var(--deny);
    border: 1px solid var(--deny-border);
    border-radius: 8px;
    padding: 10px 14px;
    font-family: var(--font-serif);
    font-size: 13px;
  }

  /* Numbered agent cards — the position-in-ordering is the load-bearing
     cue, so the index circle is sized to read at a glance. */
  .agent-card {
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
  }
  .agent-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--surface-warm);
    border-bottom: 1px solid var(--border-soft);
  }
  .agent-index {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .panel.canonical .agent-index { background: var(--muted-soft); }
  .agent-name {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-strong);
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  .agent-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    text-align: right;
  }
  .agent-meta .cache-hit {
    color: var(--approve);
    font-weight: 600;
    margin-left: 6px;
  }
  .agent-response {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--ink);
    background: var(--surface);
    max-height: 520px;
    overflow: auto;
  }

  .empty {
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
  }

  /* Risk-phrase highlights — three pastels keyed to the report palette. */
  .phrase-deny    { background: var(--deny-bg);    color: var(--deny);    padding: 0 3px; border-radius: 3px; font-weight: 600; }
  .phrase-approve { background: var(--approve-bg); color: var(--approve); padding: 0 3px; border-radius: 3px; font-weight: 600; }
  .phrase-concern { background: var(--concern-bg); color: var(--concern); padding: 0 3px; border-radius: 3px; font-weight: 600; }

  .legend {
    margin-top: 32px;
    padding: 14px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--muted-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
  }
  .legend-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .legend span.phrase-deny,
  .legend span.phrase-approve,
  .legend span.phrase-concern {
    font-family: var(--font-sans);
    font-size: 12px;
  }
  .legend .legend-note {
    flex-basis: 100%;
    color: var(--muted-soft);
    font-style: italic;
    margin-top: 4px;
    line-height: 1.45;
    font-size: 12.5px;
  }

  /* F4 attribution panel — per-flip leave-one-out summary. */
  .ablation {
    margin-top: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .ablation header {
    padding: 18px 22px 14px;
    background: var(--surface-warm);
    border-bottom: 1px solid var(--border-soft);
  }
  .ablation .panel-eyebrow {
    color: var(--accent);
    margin-bottom: 4px;
  }
  .ablation h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--ink-strong);
    margin: 0 0 8px;
    letter-spacing: -0.005em;
  }
  .ablation .headline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--ink);
    margin: 0;
  }
  .ablation .scope-note {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    line-height: 1.45;
  }
  .ablation-corrupt header { background: var(--deny-bg); }
  .ablation-corrupt h2 { color: var(--deny); }
  .ablation-corrupt code {
    font-family: var(--font-mono);
    background: var(--border-soft);
    padding: 1px 4px;
    border-radius: 3px;
  }
  .ablation .body {
    padding: 18px 22px 22px;
  }
  .ablation table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .ablation th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-soft);
  }
  .ablation th.num { text-align: right; }
  .ablation td {
    padding: 10px;
    border-bottom: 1px solid var(--border-soft);
    color: var(--ink-strong);
    vertical-align: middle;
  }
  .ablation td.num { text-align: right; }
  .ablation tr.is-terminal td {
    background: var(--border-soft);
    color: var(--muted-soft);
  }
  .ablation tr.is-terminal .baseline-tag {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
    margin-left: 6px;
  }
  .ablation .bar {
    display: inline-block;
    height: 8px;
    border-radius: 4px;
    background: var(--accent);
    margin-right: 8px;
    vertical-align: middle;
    min-width: 1px;
  }
  .ablation tr.is-terminal .bar { background: var(--muted); }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<div class="container">
  <h1>Where did the AIs diverge?</h1>
  <p class="subhead">
    Same agents. Same input. Two different orderings &mdash; and two
    different verdicts. Read the responses agent-by-agent to see exactly
    which step changed its mind.
  </p>
  <div class="meta">
    <span class="pair"><span class="k">Run</span><span class="v">{{ run_id }}</span></span>
    <span class="pair"><span class="k">Eval</span><span class="v">{{ eval_id }}</span></span>
    <span class="pair"><span class="k">Topology</span><span class="v">{{ topology_name }}</span></span>
    <span class="pair"><span class="k">Verdict threshold</span><span class="v">{{ "%.2f"|format(threshold) }}</span></span>
  </div>
  <div class="grid">
    {% for side in [canonical, flipping] %}
    <section class="panel {{ 'canonical' if loop.first else 'flipping' }}">
      <header>
        <div class="panel-eyebrow">
          {% if loop.first %}Original ordering &middot; baseline{% else %}Reordered &middot; verdict flipped{% endif %}
        </div>
        <h2>{{ side.label }}
          <span class="verdict {{ side.verdict_class }}">{{ side.verdict }}</span>
        </h2>
        <div class="panel-hash">Variant <code>{{ side.short_hash }}</code></div>
        <div class="ordering">
          {% for node_id in side.ordering -%}
            <span class="step">{{ node_id }}</span>
            {%- if not loop.last %}<span class="arrow">&rarr;</span>{% endif -%}
          {%- endfor %}
        </div>
      </header>
      <div class="panel-body">
        {% if side.error %}
          <div class="error-banner">Cell error: {{ side.error }}</div>
        {% endif %}
        {% if side.rationale_html %}
          <div class="rationale">
            <div class="rationale-label">Judge rationale</div>
            {{ side.rationale_html }}
          </div>
        {% endif %}
        {% if side.jury_votes %}
          <div class="jury">
            <div class="jury-head">
              <span class="jury-label">Jury vote breakdown</span>
              <span class="jury-summary">
                {%- set jv = side.jury_votes -%}
                <strong>{{ jv.approve_count }}</strong> approve &middot;
                <strong>{{ jv.deny_count }}</strong> deny
                &middot; {{ jv.total }} judges &middot;
                <span class="verdict {{ jv.majority_class }}">{{ jv.majority_label }}</span>
              </span>
            </div>
            <div class="jury-rows">
              {% for row in side.jury_votes.rows %}
                <div class="jury-row">
                  <span class="jury-vendor">{{ row.vendor }}</span>
                  <span class="jury-score">{{ row.score_value }} &middot; {{ row.score_pct }}</span>
                  <span class="jury-verdict">
                    <span class="verdict {{ row.verdict_class }}">{{ row.verdict_label }}</span>
                  </span>
                  {% if row.rationale_html %}
                    <div class="jury-rationale">{{ row.rationale_html }}</div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
        {% for agent in side.agents %}
          <div class="agent-card">
            <div class="agent-head">
              <span class="agent-index">{{ loop.index }}</span>
              <p class="agent-name">{{ agent.role or agent.node_id }}</p>
              <span class="agent-meta">
                {%- if agent.role and agent.role != agent.node_id -%}
                  {{ agent.node_id }} &middot;
                {% endif -%}
                {{ agent.model }}
                {% if agent.cache_hit %}<span class="cache-hit">&middot; cache hit</span>{% endif %}
              </span>
            </div>
            <pre class="agent-response">{{ agent.response_html }}</pre>
          </div>
        {% else %}
          <p class="empty">No agent outputs recorded for this cell.</p>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>
  {% if ablation %}
  <section class="ablation">
    <header>
      <div class="panel-eyebrow">Counterfactual attribution &middot; F4</div>
      <h2>Which agent caused this flip?</h2>
      <p class="headline">{{ ablation.headline }}</p>
      <p class="scope-note">{{ ablation.scope_note }}</p>
    </header>
    <div class="body">
      <table>
        <thead>
          <tr>
            <th>Ablated agent</th>
            <th>Experiment kind</th>
            <th class="num">Flips closed</th>
            <th class="num">Attribution</th>
          </tr>
        </thead>
        <tbody>
        {% for row in ablation.rows %}
          <tr class="{{ 'is-terminal' if row.is_terminal else '' }}">
            <td>{{ row.node_id }}</td>
            <td>
              {%- if row.kind == "substitute_terminal" -%}
                terminal substitution
              {%- elif row.kind == "reexecute_terminal" -%}
                terminal re-execution (hybrid prior)
              {%- elif row.kind == "skip_downstream" -%}
                ran after terminal in this variant &mdash; skipped
              {%- elif row.kind == "skip_no_canonical_output" -%}
                no canonical output &mdash; skipped
              {%- elif row.kind == "skip_no_v_output" -%}
                no variant output &mdash; skipped
              {%- elif row.kind == "failed" -%}
                re-execution failed
              {%- else -%}
                {{ row.kind }}
              {%- endif -%}
            </td>
            {% if row.has_measurement %}
            <td class="num">{{ row.flips_closed }} / {{ row.total_meaningful }}</td>
            <td class="num">
              <span class="bar" style="width:{{ row.attribution_pct|round(0, 'floor')|int }}px"></span>
              {{ "%.0f"|format(row.attribution_pct) }}%
              {% if row.is_terminal %}<span class="baseline-tag">baseline</span>{% endif %}
            </td>
            {% else %}
            {# Pass-1 Fuzzer BLOCKER B2: skip / failed rows show em-dash,
               NOT a 0% bar that reads as "this agent contributes nothing". #}
            <td class="num">&mdash;</td>
            <td class="num"><span class="baseline-tag">no measurement</span></td>
            {% endif %}
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}
  {% if ablation_corrupt_msg %}
  {# Pass-1 RT MAJOR M6: an ablation sidecar is present but unreadable.
     Surface visibly so the buyer doesn't conclude "no ablation has been
     run" and pay twice. #}
  <section class="ablation ablation-corrupt">
    <header>
      <div class="panel-eyebrow">Counterfactual attribution &middot; F4</div>
      <h2>Attribution data unavailable</h2>
      <p class="headline">
        An ablation pass HAS been run on this run dir, but its
        <code>ablation.json</code> sidecar is corrupt: {{ ablation_corrupt_msg }}
      </p>
      <p class="scope-note">Re-run <code>topofuzz ablate &lt;run_dir&gt;</code> to repair.</p>
    </header>
  </section>
  {% endif %}
  <div class="legend">
    <span class="legend-label">Highlighted phrases</span>
    <span class="phrase-deny">deny &middot; decline &middot; reject</span>
    <span class="phrase-approve">approve &middot; grant</span>
    <span class="phrase-concern">concern &middot; risk &middot; exception</span>
    <span class="legend-note">
      Highlights are case-insensitive matches on common decision verbs.
      They're a reading aid, not a verdict &mdash; the binary call comes
      from the judge model named in the run report.
    </span>
  </div>
</div>
</body>
</html>
