"""Standalone reproducer for topofuzz run {{ run_id }}, eval {{ eval_id }}.

Topofuzz observed that two node-orderings produce disagreeing verdicts
on this input. Re-run both orderings yourself to confirm the flip is
real, not p-hacked.

Usage:
    pip install litellm
    export GOOGLE_API_KEY=...   # or whichever provider your LLM_CONFIGS use
    python repro_{{ eval_id }}.py

Exits with AssertionError if the two orderings agree (could mean LLM
noise, a missing API key, or a stale topology). Exits 0 silently when
they disagree as observed. Fully standalone: no dependency on the
fuzzer itself.
"""
{{ import_line }}
import litellm

EVAL_INPUT = {{ eval_input | tojson }}

# Variant {{ hash_neg_short }} — verdict score < {{ threshold }} ("DENY" side of flip)
ORDERING_NEG = {{ ordering_neg | tojson }}
# Variant {{ hash_pos_short }} — verdict score >= {{ threshold }} ("APPROVE" side)
ORDERING_POS = {{ ordering_pos | tojson }}
# Node the orchestrator declared as the verdict producer — what
# ``topofuzz.runner._run_judge`` actually scored. The reproducer must
# compare THIS node's output across orderings (Step 20a / F6 BLOCKER
# fix), not whatever node a permutation happened to walk last. ``None``
# for v0.5 manifests that predate the ``terminal_nodes`` / ``verdict_node``
# fields — falls back to the last node walked.
# NOTE: explicit ``None`` branch — Jinja's ``tojson`` filter emits JSON
# ``null`` for Python ``None``, which is NOT a valid Python literal and
# would NameError at script load.
VERDICT_NODE = {% if verdict_node is none %}None{% else %}{{ verdict_node | tojson }}{% endif %}


def _cfg_field(cfg, name, default):
    """LLM_CONFIGS values may be dataclasses (attr access) or plain dicts."""
    if hasattr(cfg, name):
        return getattr(cfg, name)
    if isinstance(cfg, dict):
        return cfg.get(name, default)
    return default


def run_chain(ordering, llm_configs, verdict_node):
    """Run nodes sequentially in ``ordering``; return verdict_node's output.

    Each node sees prior outputs. When ``verdict_node`` is set we return the
    response of that specific node id (matches ``topofuzz.runner._run_judge``
    dispatch) regardless of whether it ran first, last, or in the middle.
    When ``verdict_node`` is ``None`` (v0.5 manifest) we fall back to the
    last node walked.
    """
    history = []
    for node_id in ordering:
        cfg = llm_configs[node_id]
        prior = "\n".join(f"- {nid}: {out}" for nid, out in history) or "(none)"
        prompt = (
            f"You are agent {node_id}. Previous outputs:\n{prior}\n\n"
            f"User input: {EVAL_INPUT}"
        )
        resp = litellm.completion(
            model=_cfg_field(cfg, "model", ""),
            temperature=_cfg_field(cfg, "temperature", 0.0) or 0.0,
            messages=[{"role": "user", "content": prompt}],
        )
        history.append((node_id, resp.choices[0].message.content))
    if verdict_node is not None:
        for nid, out in history:
            if nid == verdict_node:
                return out
        # Exit 1 with a single-line banner rather than raise AssertionError
        # so a compliance reviewer running this script sees a clear
        # "topology drift" message instead of a Python traceback they might
        # dismiss as "Gemini rate-limit". Exit 1 matches the existing
        # empty-LLM-response branch below — both are "inconclusive
        # reproduction" failures — and avoids collision with the topofuzz
        # CLI's exit-2 == bad-usage convention (cli.py:_BAD_USAGE_EXIT).
        import sys
        print(
            f"REPRO INCONCLUSIVE: verdict_node {verdict_node!r} did not "
            f"appear in ordering {ordering!r} — topology drifted since the "
            "run was captured; re-run the original topofuzz audit.",
            file=sys.stderr,
        )
        sys.exit(1)
    return history[-1][1]


if __name__ == "__main__":
    out_neg = run_chain(ORDERING_NEG, LLM_CONFIGS, VERDICT_NODE)
    out_pos = run_chain(ORDERING_POS, LLM_CONFIGS, VERDICT_NODE)
    print(f"Ordering NEG {ORDERING_NEG}\n  final: {out_neg!r}\n")
    print(f"Ordering POS {ORDERING_POS}\n  final: {out_pos!r}\n")
    if not out_neg or not out_pos:
        import sys
        sys.exit(
            "Empty LLM response — check API key, quota, and content-filter "
            "settings. Reproduction inconclusive."
        )
    assert out_neg != out_pos, "Reproduction failed: final outputs agreed."
